{
  "description": "conf.ide hooks for Codex. The scripts are the ones Claude Code runs from .claude/hooks.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/comment-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Counting comment lines"
          }
        ]
      }
    ]
  }
}
